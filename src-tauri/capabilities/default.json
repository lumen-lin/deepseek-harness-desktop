{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口（壳页面）权限：事件、命令与自绘标题栏的窗口控制（拖拽/最小化/最大化/关闭）。壳页面由本地服务站提供，端口每次启动由系统分配，静态 capability 无法精确匹配，只能放行 127.0.0.1 来源。注意 ACL 只能按 host:port 授权，挡不住「本机另一个进程提供的同源页面」——真正的权限边界是 shell.rs 下发的调用令牌（每个自定义命令都校验）与 nav.rs 的端口白名单，ACL 只是第一层。",
  "local": true,
  "remote": { "urls": ["http://127.0.0.1:*/*", "http://127.0.0.1:*"] },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-hide",
    "allow-app-commands"
  ]
}
